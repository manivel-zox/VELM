# ==============================================================================
# VELMART E-Commerce Application - Environment Configuration Variables Template
# Copy this file to '.env' or set these environment variables in your server/OS.
# NEVER commit real credentials to source control.
# ==============================================================================

# Active Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# Application Port
SERVER_PORT=8080

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=velmart_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# Full Spring DataSource URL override (Optional)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/velmart_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Initial Admin Account Seed Setup (Optional custom admin override)
ADMIN_INITIAL_EMAIL=admin@velmart.com
ADMIN_INITIAL_PASSWORD=Admin@Velmart2026!
ADMIN_INITIAL_NAME=Velmart Platform Admin

# Session Security Configuration
SESSION_TIMEOUT_MINUTES=60
COOKIE_SECURE=false
